{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/push",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/backup",
      "schedule": "0 18 * * 0"
    }
  ],
  "functions": {
    "api/backup.js": {
      "maxDuration": 60
    }
  }
}